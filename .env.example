ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key

# Optional real-money trading. Paper remains the default and uses only the keys above.
# To enable Live, set ALPACA_TRADING_MODE=live, set this explicit kill switch to true,
# and supply separate credentials from the Alpaca live account dashboard.
ALPACA_TRADING_MODE=paper
ALPACA_LIVE_TRADING_ENABLED=false
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_MAX_ORDER_USD=500
# On hosted services, point this at an absolute, mounted persistent disk path.
ALPACA_LIVE_DATA_DIR=

# Optional bot alerts. Configure Telegram, Discord, or both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
